# Client-side API URL (currently used for authentication only)
# Development: http://localhost:8000/api/v1 (MUST use localhost for httpOnly cookies to work!)
# Production: /api/v1 (once reverse proxy is set up)
NEXT_PUBLIC_BACKEND_API=http://localhost:8000/api/v1

# Server-side API URL (for server-side data fetching)
# Development: http://localhost:8000/api/v1 (MUST use localhost for consistency!)
# Production: https://observer-prd.pmacs.upenn.edu/api/v1
INTERNAL_BACKEND_API=http://localhost:8000/api/v1

# Google Analytics Measurement ID (optional - leave empty to disable)
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=